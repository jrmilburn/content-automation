generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  ACTIVE
  DISABLED

  @@map("workspace_status")
}

enum InternalUserStatus {
  ACTIVE
  DISABLED

  @@map("internal_user_status")
}

enum InternalUserRole {
  MEMBER
  ADMIN

  @@map("internal_user_role")
}

enum AuditActorType {
  USER
  SERVICE
  SYSTEM

  @@map("audit_actor_type")
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON

  @@map("setting_value_type")
}

enum JobDispatchStatus {
  PENDING
  DISPATCHED
  CANCELLED

  @@map("job_dispatch_status")
}

enum BackgroundJobState {
  QUEUED
  PROCESSING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED_ATTENTION
  CANCELLED

  @@map("background_job_state")
}

enum JobAttemptState {
  ACTIVE
  SUCCEEDED
  RETRY_SCHEDULED
  FAILED_ATTENTION
  LEASE_EXPIRED
  CANCELLED

  @@map("job_attempt_state")
}

enum IntegrationType {
  INSTAGRAM

  @@map("integration_type")
}

enum InstagramAccountType {
  BUSINESS
  CREATOR

  @@map("instagram_account_type")
}

enum InstagramConnectionStatus {
  ACTIVE
  REAUTHORISATION_REQUIRED
  DISCONNECTED

  @@map("instagram_connection_status")
}

enum IntegrationCredentialStatus {
  ACTIVE
  REAUTHORISATION_REQUIRED
  REVOKED

  @@map("integration_credential_status")
}

// UNSUPPORTED retains media whose provider type is not one this product
// understands, so an unknown value stays inspectable instead of being dropped.
enum InstagramMediaKind {
  REEL
  VIDEO
  IMAGE
  CAROUSEL_ALBUM
  UNSUPPORTED

  @@map("instagram_media_kind")
}

enum SyncRunTrigger {
  BOOTSTRAP
  MANUAL
  SCHEDULED
  RECONCILE

  @@map("sync_run_trigger")
}

enum SyncRunState {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_run_state")
}

model Workspace {
  id             String                  @id @db.Uuid
  slug           String                  @unique @db.VarChar(63)
  name           String                  @db.VarChar(120)
  timezone       String                  @default("Australia/Sydney") @db.VarChar(64)
  status         WorkspaceStatus         @default(ACTIVE)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditEvents    AuditEvent[]
  backgroundJobs BackgroundJob[]
  credentials    IntegrationCredential[]
  igAccounts     InstagramAccount[]
  igPosts        InstagramPost[]
  jobAttempts    JobAttempt[]
  jobOutbox      JobOutbox[]
  settings       SystemSetting[]
  syncRuns       SyncRun[]
  users          InternalUser[]

  @@index([status])
  @@map("workspaces")
}

model BackgroundJob {
  id                       String             @id @db.Uuid
  workspaceId              String             @map("workspace_id") @db.Uuid
  queueName                String             @map("queue_name") @db.VarChar(80)
  handlerVersion           Int                @map("handler_version")
  idempotencyKey           String             @map("idempotency_key") @db.VarChar(255)
  correlationId            String             @map("correlation_id") @db.Uuid
  dispatchStatus           JobDispatchStatus  @default(PENDING) @map("dispatch_status")
  state                    BackgroundJobState @default(QUEUED)
  stage                    String             @default("queued") @db.VarChar(64)
  priority                 Int                @default(0)
  attemptCount             Int                @default(0) @map("attempt_count")
  maxAttempts              Int                @default(8) @map("max_attempts")
  version                  Int                @default(1)
  resourceType             String?            @map("resource_type") @db.VarChar(64)
  resourceId               String?            @map("resource_id") @db.Uuid
  inputVersion             String?            @map("input_version") @db.VarChar(128)
  queuedAt                 DateTime           @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt                DateTime?          @map("started_at") @db.Timestamptz(3)
  heartbeatAt              DateTime?          @map("heartbeat_at") @db.Timestamptz(3)
  leaseId                  String?            @map("lease_id") @db.Uuid
  leaseExpiresAt           DateTime?          @map("lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt            DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  completedAt              DateTime?          @map("completed_at") @db.Timestamptz(3)
  lastErrorClass           String?            @map("last_error_class") @db.VarChar(32)
  lastErrorCode            String?            @map("last_error_code") @db.VarChar(64)
  nextAction               String?            @map("next_action") @db.VarChar(32)
  cancellationRequestedAt  DateTime?          @map("cancellation_requested_at") @db.Timestamptz(3)
  cancellationReasonCode   String?            @map("cancellation_reason_code") @db.VarChar(64)
  reconciliationRequiredAt DateTime?          @map("reconciliation_required_at") @db.Timestamptz(3)
  reconciliationCode       String?            @map("reconciliation_code") @db.VarChar(64)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  outbox                   JobOutbox?
  attempts                 JobAttempt[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, queueName, handlerVersion, idempotencyKey])
  @@index([workspaceId, dispatchStatus, createdAt])
  @@index([workspaceId, state, nextAttemptAt, priority, queuedAt])
  @@index([state, leaseExpiresAt])
  @@index([correlationId])
  @@map("background_jobs")
}

model JobAttempt {
  id              String          @id @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  backgroundJobId String          @map("background_job_id") @db.Uuid
  attemptNumber   Int             @map("attempt_number")
  handlerVersion  Int             @map("handler_version")
  state           JobAttemptState @default(ACTIVE)
  stage           String          @default("starting") @db.VarChar(64)
  leaseId         String          @unique @map("lease_id") @db.Uuid
  correlationId   String          @map("correlation_id") @db.Uuid
  startedAt       DateTime        @map("started_at") @db.Timestamptz(3)
  heartbeatAt     DateTime        @map("heartbeat_at") @db.Timestamptz(3)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(3)
  nextAttemptAt   DateTime?       @map("next_attempt_at") @db.Timestamptz(3)
  errorClass      String?         @map("error_class") @db.VarChar(32)
  errorCode       String?         @map("error_code") @db.VarChar(64)
  nextAction      String?         @map("next_action") @db.VarChar(32)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  backgroundJob   BackgroundJob   @relation(fields: [workspaceId, backgroundJobId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([backgroundJobId, attemptNumber])
  @@index([workspaceId, state, startedAt])
  @@index([backgroundJobId, completedAt])
  @@map("job_attempts")
}

model JobOutbox {
  id                   String        @id @db.Uuid
  workspaceId          String        @map("workspace_id") @db.Uuid
  backgroundJobId      String        @unique @map("background_job_id") @db.Uuid
  queueName            String        @map("queue_name") @db.VarChar(80)
  handlerVersion       Int           @map("handler_version")
  correlationId        String        @map("correlation_id") @db.Uuid
  dispatchAttemptCount Int           @default(0) @map("dispatch_attempt_count")
  nextAttemptAt        DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseId              String?       @map("lease_id") @db.Uuid
  leaseExpiresAt       DateTime?     @map("lease_expires_at") @db.Timestamptz(3)
  queueDeliveryId      String?       @map("queue_delivery_id") @db.Uuid
  lastErrorCode        String?       @map("last_error_code") @db.VarChar(64)
  dispatchedAt         DateTime?     @map("dispatched_at") @db.Timestamptz(3)
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  backgroundJob        BackgroundJob @relation(fields: [workspaceId, backgroundJobId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, backgroundJobId])
  @@index([dispatchedAt, nextAttemptAt, leaseExpiresAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("job_outbox")
}

model InternalUser {
  id               String             @id @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  oidcSubject      String?            @map("oidc_subject") @db.VarChar(255)
  email            String             @db.Citext
  displayName      String?            @map("display_name") @db.VarChar(160)
  status           InternalUserStatus @default(ACTIVE)
  role             InternalUserRole   @default(MEMBER)
  sessionVersion   Int                @default(1) @map("session_version")
  lastLoginAt      DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorAuditEvents AuditEvent[]       @relation("audit_actor_user")
  changedSettings  SystemSetting[]    @relation("setting_changed_by_user")

  @@unique([workspaceId, id])
  @@unique([workspaceId, oidcSubject])
  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@map("internal_users")
}

model AuditEvent {
  id            String         @id @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  actorService  String?        @map("actor_service") @db.VarChar(100)
  action        String         @db.VarChar(120)
  resourceType  String         @map("resource_type") @db.VarChar(100)
  resourceId    String?        @map("resource_id") @db.VarChar(255)
  outcome       String?        @db.VarChar(32)
  reasonCode    String?        @map("reason_code") @db.VarChar(64)
  beforeHash    String?        @map("before_hash") @db.Char(64)
  afterHash     String?        @map("after_hash") @db.Char(64)
  correlationId String         @map("correlation_id") @db.Uuid
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUser     InternalUser?  @relation("audit_actor_user", fields: [workspaceId, actorUserId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, resourceType, resourceId])
  @@index([workspaceId, actorUserId, action, occurredAt])
  @@map("audit_events")
}

model InstagramAccount {
  id                      String                    @id @db.Uuid
  workspaceId             String                    @map("workspace_id") @db.Uuid
  providerAccountId       String                    @map("provider_account_id") @db.VarChar(64)
  username                String?                   @db.VarChar(120)
  accountType             InstagramAccountType      @map("account_type")
  mediaCount              Int?                      @map("media_count")
  followerCount           Int?                      @map("follower_count")
  followerCountObservedAt DateTime?                 @map("follower_count_observed_at") @db.Timestamptz(3)
  connectionStatus        InstagramConnectionStatus @default(ACTIVE) @map("connection_status")
  tokenExpiresAt          DateTime?                 @map("token_expires_at") @db.Timestamptz(3)
  grantedScopes           String[]                  @map("granted_scopes")
  lastSuccessfulSyncAt    DateTime?                 @map("last_successful_sync_at") @db.Timestamptz(3)
  apiVersion              String                    @map("api_version") @db.VarChar(16)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace               Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  credentials             IntegrationCredential[]
  posts                   InstagramPost[]
  syncRuns                SyncRun[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, providerAccountId])
  @@index([workspaceId, connectionStatus])
  @@index([workspaceId, tokenExpiresAt])
  @@index([workspaceId, lastSuccessfulSyncAt])
  @@map("instagram_accounts")
}

// Ciphertext is envelope-encrypted by packages/db/src/credential-encryption.ts
// and is never selected into product responses, logs or idempotency inputs. A
// partial unique index in the migration enforces one ACTIVE credential per
// (integration_type, account_id) while retaining superseded rows; Prisma cannot
// express a filtered unique index, so it lives in SQL only.
model IntegrationCredential {
  id                       String                      @id @db.Uuid
  workspaceId              String                      @map("workspace_id") @db.Uuid
  integrationType          IntegrationType             @map("integration_type")
  accountId                String                      @map("account_id") @db.Uuid
  ciphertext               String
  keyVersion               Int                         @map("key_version")
  tokenType                String                      @map("token_type") @db.VarChar(32)
  scopeHash                String                      @map("scope_hash") @db.Char(64)
  status                   IntegrationCredentialStatus @default(ACTIVE)
  issuedAt                 DateTime                    @map("issued_at") @db.Timestamptz(3)
  expiresAt                DateTime?                   @map("expires_at") @db.Timestamptz(3)
  refreshedAt              DateTime?                   @map("refreshed_at") @db.Timestamptz(3)
  lastValidatedAt          DateTime?                   @map("last_validated_at") @db.Timestamptz(3)
  lastValidationErrorClass String?                     @map("last_validation_error_class") @db.VarChar(64)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account                  InstagramAccount            @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, expiresAt])
  @@index([workspaceId, accountId, status])
  @@map("integration_credentials")
}

// One normalised owned-media record. `rawPayload` is restricted provenance and
// is never selected into product responses or logs; the safe projection in
// packages/db/src/instagram-media.ts is the only supported read path.
//
// The provider's signed CDN URLs are deliberately not durable storage:
// `providerThumbnailUrl` is display metadata that expires, and `media_url` is
// never given a column at all. Neither is a source asset — that is a separate
// uploaded, validated object introduced by the video upload work.
model InstagramPost {
  id                   String             @id @db.Uuid
  workspaceId          String             @map("workspace_id") @db.Uuid
  instagramAccountId   String             @map("instagram_account_id") @db.Uuid
  providerMediaId      String             @map("provider_media_id") @db.VarChar(64)
  mediaKind            InstagramMediaKind @map("media_kind")
  mediaType            String             @map("media_type") @db.VarChar(32)
  mediaProductType     String?            @map("media_product_type") @db.VarChar(32)
  caption              String?
  permalink            String?
  publishedAt          DateTime           @map("published_at") @db.Timestamptz(3)
  providerThumbnailUrl String?            @map("provider_thumbnail_url")
  firstImportedAt      DateTime           @map("first_imported_at") @db.Timestamptz(3)
  lastImportedAt       DateTime           @map("last_imported_at") @db.Timestamptz(3)
  lastSyncRunId        String?            @map("last_sync_run_id") @db.Uuid
  rawPayload           Json               @map("raw_payload")
  rawPayloadHash       String             @map("raw_payload_hash") @db.Char(64)
  rawApiVersion        String             @map("raw_api_version") @db.VarChar(16)
  rawRetrievedAt       DateTime           @map("raw_retrieved_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account              InstagramAccount   @relation(fields: [workspaceId, instagramAccountId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([instagramAccountId, providerMediaId])
  @@index([workspaceId, instagramAccountId, publishedAt(sort: Desc)])
  @@index([workspaceId, instagramAccountId, mediaKind])
  @@index([workspaceId, instagramAccountId, lastImportedAt])
  @@map("instagram_posts")
}

// One auditable import run. The cursor is opaque provider state and is advanced
// only in the same transaction that commits a page's posts, so a resumed run
// can never skip records. A partial unique index in the migration enforces one
// RUNNING run per account and trigger; Prisma cannot express a filtered unique
// index, so it lives in SQL only.
model SyncRun {
  id                 String           @id @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  instagramAccountId String           @map("instagram_account_id") @db.Uuid
  trigger            SyncRunTrigger
  idempotencyKey     String           @map("idempotency_key") @db.VarChar(255)
  backgroundJobId    String?          @map("background_job_id") @db.Uuid
  state              SyncRunState     @default(RUNNING)
  stage              String           @default("starting") @db.VarChar(64)
  horizonStart       DateTime?        @map("horizon_start") @db.Timestamptz(3)
  cursor             String?          @db.VarChar(512)
  pagesCompleted     Int              @default(0) @map("pages_completed")
  itemsSeen          Int              @default(0) @map("items_seen")
  itemsImported      Int              @default(0) @map("items_imported")
  itemsUpdated       Int              @default(0) @map("items_updated")
  itemsSkipped       Int              @default(0) @map("items_skipped")
  itemsInvalid       Int              @default(0) @map("items_invalid")
  apiVersion         String           @map("api_version") @db.VarChar(16)
  usageSummary       Json?            @map("usage_summary")
  correlationId      String           @map("correlation_id") @db.Uuid
  startedAt          DateTime         @map("started_at") @db.Timestamptz(3)
  checkpointAt       DateTime?        @map("checkpoint_at") @db.Timestamptz(3)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(3)
  failureClass       String?          @map("failure_class") @db.VarChar(32)
  failureCode        String?          @map("failure_code") @db.VarChar(64)
  requestedByUserId  String?          @map("requested_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account            InstagramAccount @relation(fields: [workspaceId, instagramAccountId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, instagramAccountId, trigger, idempotencyKey])
  @@index([workspaceId, instagramAccountId, startedAt(sort: Desc)])
  @@index([workspaceId, state, startedAt])
  @@index([correlationId])
  @@map("sync_runs")
}

model SystemSetting {
  id               String           @id @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  key              String           @db.VarChar(120)
  valueType        SettingValueType @map("value_type")
  value            Json
  version          Int
  effectiveAt      DateTime         @map("effective_at") @db.Timestamptz(3)
  changedByUserId  String?          @map("changed_by_user_id") @db.Uuid
  changedByService String?          @map("changed_by_service") @db.VarChar(100)
  changeReason     String           @map("change_reason") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  changedByUser    InternalUser?    @relation("setting_changed_by_user", fields: [workspaceId, changedByUserId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, key, version])
  @@index([workspaceId, key, effectiveAt(sort: Desc)])
  @@map("system_settings")
}
