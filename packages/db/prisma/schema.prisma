generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  ACTIVE
  DISABLED

  @@map("workspace_status")
}

enum InternalUserStatus {
  ACTIVE
  DISABLED

  @@map("internal_user_status")
}

enum InternalUserRole {
  MEMBER
  ADMIN

  @@map("internal_user_role")
}

enum AuditActorType {
  USER
  SERVICE
  SYSTEM

  @@map("audit_actor_type")
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON

  @@map("setting_value_type")
}

enum JobDispatchStatus {
  PENDING
  DISPATCHED
  CANCELLED

  @@map("job_dispatch_status")
}

enum BackgroundJobState {
  QUEUED
  PROCESSING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED_ATTENTION
  CANCELLED

  @@map("background_job_state")
}

enum JobAttemptState {
  ACTIVE
  SUCCEEDED
  RETRY_SCHEDULED
  FAILED_ATTENTION
  LEASE_EXPIRED
  CANCELLED

  @@map("job_attempt_state")
}

enum IntegrationType {
  INSTAGRAM

  @@map("integration_type")
}

enum InstagramAccountType {
  BUSINESS
  CREATOR

  @@map("instagram_account_type")
}

enum InstagramConnectionStatus {
  ACTIVE
  REAUTHORISATION_REQUIRED
  DISCONNECTED

  @@map("instagram_connection_status")
}

enum IntegrationCredentialStatus {
  ACTIVE
  REAUTHORISATION_REQUIRED
  REVOKED

  @@map("integration_credential_status")
}

// UNSUPPORTED retains media whose provider type is not one this product
// understands, so an unknown value stays inspectable instead of being dropped.
enum InstagramMediaKind {
  REEL
  VIDEO
  IMAGE
  CAROUSEL_ALBUM
  UNSUPPORTED

  @@map("instagram_media_kind")
}

enum SyncRunTrigger {
  BOOTSTRAP
  MANUAL
  SCHEDULED
  RECONCILE

  @@map("sync_run_trigger")
}

enum SyncRunState {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_run_state")
}

// Why a metric has no value. NOT_REQUESTED means the capability map never asked;
// UNAVAILABLE means the provider was asked and returned nothing. Collapsing the
// two would make a gap in our configuration look like a gap in Meta's data.
enum InstagramMetricAvailability {
  AVAILABLE
  UNAVAILABLE
  NOT_APPLICABLE
  PERMISSION_MISSING
  PROVIDER_ERROR
  NOT_REQUESTED

  @@map("instagram_metric_availability")
}

// Post-age cohort. Analytics may only compare snapshots from the same bucket, so
// it is stored at capture rather than derived later from a timestamp.
enum InstagramSnapshotBucket {
  IMPORT
  HOUR_1
  DAY_1
  DAY_3
  DAY_7
  DAY_30
  MATURE

  @@map("instagram_snapshot_bucket")
}

model Workspace {
  id             String                    @id @db.Uuid
  slug           String                    @unique @db.VarChar(63)
  name           String                    @db.VarChar(120)
  timezone       String                    @default("Australia/Sydney") @db.VarChar(64)
  status         WorkspaceStatus           @default(ACTIVE)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  analysisJobs   AnalysisJob[]
  auditEvents    AuditEvent[]
  backgroundJobs BackgroundJob[]
  featureStatistics     AccountFeatureStatistic[]
  featureStatisticPosts AccountFeatureStatisticPost[]
  postAnalyses   PostAnalysis[]
  credentials    IntegrationCredential[]
  igAccounts     InstagramAccount[]
  igPosts        InstagramPost[]
  igSnapshots    InstagramMetricSnapshot[]
  jobAttempts    JobAttempt[]
  jobOutbox      JobOutbox[]
  settings       SystemSetting[]
  syncRuns       SyncRun[]
  users          InternalUser[]
  videoAssets    VideoAsset[]
  uploadIntents  VideoUploadIntent[]

  @@index([status])
  @@map("workspaces")
}

model BackgroundJob {
  id                       String             @id @db.Uuid
  workspaceId              String             @map("workspace_id") @db.Uuid
  queueName                String             @map("queue_name") @db.VarChar(80)
  handlerVersion           Int                @map("handler_version")
  idempotencyKey           String             @map("idempotency_key") @db.VarChar(255)
  correlationId            String             @map("correlation_id") @db.Uuid
  dispatchStatus           JobDispatchStatus  @default(PENDING) @map("dispatch_status")
  state                    BackgroundJobState @default(QUEUED)
  stage                    String             @default("queued") @db.VarChar(64)
  priority                 Int                @default(0)
  attemptCount             Int                @default(0) @map("attempt_count")
  maxAttempts              Int                @default(8) @map("max_attempts")
  version                  Int                @default(1)
  resourceType             String?            @map("resource_type") @db.VarChar(64)
  resourceId               String?            @map("resource_id") @db.Uuid
  inputVersion             String?            @map("input_version") @db.VarChar(128)
  queuedAt                 DateTime           @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt                DateTime?          @map("started_at") @db.Timestamptz(3)
  heartbeatAt              DateTime?          @map("heartbeat_at") @db.Timestamptz(3)
  leaseId                  String?            @map("lease_id") @db.Uuid
  leaseExpiresAt           DateTime?          @map("lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt            DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  completedAt              DateTime?          @map("completed_at") @db.Timestamptz(3)
  lastErrorClass           String?            @map("last_error_class") @db.VarChar(32)
  lastErrorCode            String?            @map("last_error_code") @db.VarChar(64)
  nextAction               String?            @map("next_action") @db.VarChar(32)
  cancellationRequestedAt  DateTime?          @map("cancellation_requested_at") @db.Timestamptz(3)
  cancellationReasonCode   String?            @map("cancellation_reason_code") @db.VarChar(64)
  reconciliationRequiredAt DateTime?          @map("reconciliation_required_at") @db.Timestamptz(3)
  reconciliationCode       String?            @map("reconciliation_code") @db.VarChar(64)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  outbox                   JobOutbox?
  attempts                 JobAttempt[]
  analysisJob              AnalysisJob?

  @@unique([workspaceId, id])
  @@unique([workspaceId, queueName, handlerVersion, idempotencyKey])
  @@index([workspaceId, dispatchStatus, createdAt])
  @@index([workspaceId, state, nextAttemptAt, priority, queuedAt])
  @@index([state, leaseExpiresAt])
  @@index([correlationId])
  @@map("background_jobs")
}

model JobAttempt {
  id              String          @id @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  backgroundJobId String          @map("background_job_id") @db.Uuid
  attemptNumber   Int             @map("attempt_number")
  handlerVersion  Int             @map("handler_version")
  state           JobAttemptState @default(ACTIVE)
  stage           String          @default("starting") @db.VarChar(64)
  leaseId         String          @unique @map("lease_id") @db.Uuid
  correlationId   String          @map("correlation_id") @db.Uuid
  startedAt       DateTime        @map("started_at") @db.Timestamptz(3)
  heartbeatAt     DateTime        @map("heartbeat_at") @db.Timestamptz(3)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(3)
  nextAttemptAt   DateTime?       @map("next_attempt_at") @db.Timestamptz(3)
  errorClass      String?         @map("error_class") @db.VarChar(32)
  errorCode       String?         @map("error_code") @db.VarChar(64)
  nextAction      String?         @map("next_action") @db.VarChar(32)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  backgroundJob   BackgroundJob   @relation(fields: [workspaceId, backgroundJobId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([backgroundJobId, attemptNumber])
  @@index([workspaceId, state, startedAt])
  @@index([backgroundJobId, completedAt])
  @@map("job_attempts")
}

model JobOutbox {
  id                   String        @id @db.Uuid
  workspaceId          String        @map("workspace_id") @db.Uuid
  backgroundJobId      String        @unique @map("background_job_id") @db.Uuid
  queueName            String        @map("queue_name") @db.VarChar(80)
  handlerVersion       Int           @map("handler_version")
  correlationId        String        @map("correlation_id") @db.Uuid
  dispatchAttemptCount Int           @default(0) @map("dispatch_attempt_count")
  nextAttemptAt        DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseId              String?       @map("lease_id") @db.Uuid
  leaseExpiresAt       DateTime?     @map("lease_expires_at") @db.Timestamptz(3)
  queueDeliveryId      String?       @map("queue_delivery_id") @db.Uuid
  lastErrorCode        String?       @map("last_error_code") @db.VarChar(64)
  dispatchedAt         DateTime?     @map("dispatched_at") @db.Timestamptz(3)
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  backgroundJob        BackgroundJob @relation(fields: [workspaceId, backgroundJobId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, backgroundJobId])
  @@index([dispatchedAt, nextAttemptAt, leaseExpiresAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("job_outbox")
}

model InternalUser {
  id               String             @id @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  oidcSubject      String?            @map("oidc_subject") @db.VarChar(255)
  email            String             @db.Citext
  displayName      String?            @map("display_name") @db.VarChar(160)
  status           InternalUserStatus @default(ACTIVE)
  role             InternalUserRole   @default(MEMBER)
  sessionVersion   Int                @default(1) @map("session_version")
  lastLoginAt      DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorAuditEvents AuditEvent[]       @relation("audit_actor_user")
  changedSettings  SystemSetting[]    @relation("setting_changed_by_user")
  uploadIntents    VideoUploadIntent[] @relation("upload_intent_created_by_user")

  @@unique([workspaceId, id])
  @@unique([workspaceId, oidcSubject])
  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@map("internal_users")
}

model AuditEvent {
  id            String         @id @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  actorService  String?        @map("actor_service") @db.VarChar(100)
  action        String         @db.VarChar(120)
  resourceType  String         @map("resource_type") @db.VarChar(100)
  resourceId    String?        @map("resource_id") @db.VarChar(255)
  outcome       String?        @db.VarChar(32)
  reasonCode    String?        @map("reason_code") @db.VarChar(64)
  beforeHash    String?        @map("before_hash") @db.Char(64)
  afterHash     String?        @map("after_hash") @db.Char(64)
  correlationId String         @map("correlation_id") @db.Uuid
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUser     InternalUser?  @relation("audit_actor_user", fields: [workspaceId, actorUserId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, resourceType, resourceId])
  @@index([workspaceId, actorUserId, action, occurredAt])
  @@map("audit_events")
}

model InstagramAccount {
  id                      String                    @id @db.Uuid
  workspaceId             String                    @map("workspace_id") @db.Uuid
  providerAccountId       String                    @map("provider_account_id") @db.VarChar(64)
  username                String?                   @db.VarChar(120)
  accountType             InstagramAccountType      @map("account_type")
  mediaCount              Int?                      @map("media_count")
  followerCount           Int?                      @map("follower_count")
  followerCountObservedAt DateTime?                 @map("follower_count_observed_at") @db.Timestamptz(3)
  connectionStatus        InstagramConnectionStatus @default(ACTIVE) @map("connection_status")
  tokenExpiresAt          DateTime?                 @map("token_expires_at") @db.Timestamptz(3)
  grantedScopes           String[]                  @map("granted_scopes")
  lastSuccessfulSyncAt    DateTime?                 @map("last_successful_sync_at") @db.Timestamptz(3)
  apiVersion              String                    @map("api_version") @db.VarChar(16)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace               Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  credentials             IntegrationCredential[]
  posts                   InstagramPost[]
  syncRuns                SyncRun[]
  featureStatistics       AccountFeatureStatistic[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, providerAccountId])
  @@index([workspaceId, connectionStatus])
  @@index([workspaceId, tokenExpiresAt])
  @@index([workspaceId, lastSuccessfulSyncAt])
  @@map("instagram_accounts")
}

// Ciphertext is envelope-encrypted by packages/db/src/credential-encryption.ts
// and is never selected into product responses, logs or idempotency inputs. A
// partial unique index in the migration enforces one ACTIVE credential per
// (integration_type, account_id) while retaining superseded rows; Prisma cannot
// express a filtered unique index, so it lives in SQL only.
model IntegrationCredential {
  id                       String                      @id @db.Uuid
  workspaceId              String                      @map("workspace_id") @db.Uuid
  integrationType          IntegrationType             @map("integration_type")
  accountId                String                      @map("account_id") @db.Uuid
  ciphertext               String
  keyVersion               Int                         @map("key_version")
  tokenType                String                      @map("token_type") @db.VarChar(32)
  scopeHash                String                      @map("scope_hash") @db.Char(64)
  status                   IntegrationCredentialStatus @default(ACTIVE)
  issuedAt                 DateTime                    @map("issued_at") @db.Timestamptz(3)
  expiresAt                DateTime?                   @map("expires_at") @db.Timestamptz(3)
  refreshedAt              DateTime?                   @map("refreshed_at") @db.Timestamptz(3)
  lastValidatedAt          DateTime?                   @map("last_validated_at") @db.Timestamptz(3)
  lastValidationErrorClass String?                     @map("last_validation_error_class") @db.VarChar(64)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account                  InstagramAccount            @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, expiresAt])
  @@index([workspaceId, accountId, status])
  @@map("integration_credentials")
}

// One normalised owned-media record. `rawPayload` is restricted provenance and
// is never selected into product responses or logs; the safe projection in
// packages/db/src/instagram-media.ts is the only supported read path.
//
// The provider's signed CDN URLs are deliberately not durable storage:
// `providerThumbnailUrl` is display metadata that expires, and `media_url` is
// never given a column at all. Neither is a source asset — that is a separate
// uploaded, validated object introduced by the video upload work.
model InstagramPost {
  id                   String                    @id @db.Uuid
  workspaceId          String                    @map("workspace_id") @db.Uuid
  instagramAccountId   String                    @map("instagram_account_id") @db.Uuid
  providerMediaId      String                    @map("provider_media_id") @db.VarChar(64)
  mediaKind            InstagramMediaKind        @map("media_kind")
  mediaType            String                    @map("media_type") @db.VarChar(32)
  mediaProductType     String?                   @map("media_product_type") @db.VarChar(32)
  caption              String?
  permalink            String?
  publishedAt          DateTime                  @map("published_at") @db.Timestamptz(3)
  providerThumbnailUrl String?                   @map("provider_thumbnail_url")
  firstImportedAt      DateTime                  @map("first_imported_at") @db.Timestamptz(3)
  lastImportedAt       DateTime                  @map("last_imported_at") @db.Timestamptz(3)
  lastSyncRunId        String?                   @map("last_sync_run_id") @db.Uuid
  rawPayload           Json                      @map("raw_payload")
  rawPayloadHash       String                    @map("raw_payload_hash") @db.Char(64)
  rawApiVersion        String                    @map("raw_api_version") @db.VarChar(16)
  rawRetrievedAt       DateTime                  @map("raw_retrieved_at") @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account              InstagramAccount          @relation(fields: [workspaceId, instagramAccountId], references: [workspaceId, id], onDelete: Restrict)
  snapshots            InstagramMetricSnapshot[]
  videoAssets          VideoAsset[]
  uploadIntents        VideoUploadIntent[]
  analysisJobs         AnalysisJob[]
  analyses             PostAnalysis[]            @relation("PostAnalyses")
  // The analysis a reader should see. Moved transactionally when a new one is
  // published, so nothing observes a post between two current analyses.
  currentAnalysisId    String?                   @map("current_analysis_id") @db.Uuid
  currentAnalysis      PostAnalysis?             @relation("CurrentPostAnalysis", fields: [workspaceId, currentAnalysisId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  // Required by the current-analysis relation, and true anyway: an analysis is
  // current for at most one post.
  @@unique([workspaceId, currentAnalysisId])
  @@unique([instagramAccountId, providerMediaId])
  @@index([workspaceId, instagramAccountId, publishedAt(sort: Desc)])
  @@index([workspaceId, instagramAccountId, mediaKind])
  @@index([workspaceId, instagramAccountId, lastImportedAt])
  @@map("instagram_posts")
}

// One immutable observation of a post's metrics at one retrieval time.
//
// Every value column is nullable and means nothing on its own: `availability`
// carries the reason a value is absent, and Meta documents an unavailable
// insight as empty data rather than a zero, so a null here must never be read
// as "none measured". The provider's own name, unit, period, title and
// description are kept per metric inside `availability` so a definition change
// stays visible instead of silently rewriting history.
//
// Views and plays are separate columns on purpose and must never be substituted
// for one another; they are different provider definitions and merging them
// would silently change the denominator of every rate derived from them.
//
// Rows are never updated. The dedupe key is the payload hash within an age
// bucket, so re-observing identical values costs nothing while genuinely changed
// values record a new observation.
model InstagramMetricSnapshot {
  id                 String                  @id @db.Uuid
  workspaceId        String                  @map("workspace_id") @db.Uuid
  instagramPostId    String                  @map("instagram_post_id") @db.Uuid
  syncRunId          String?                 @map("sync_run_id") @db.Uuid
  capturedAt         DateTime                @map("captured_at") @db.Timestamptz(3)
  postAgeSeconds     Int                     @map("post_age_seconds")
  ageBucket          InstagramSnapshotBucket @map("age_bucket")
  apiVersion         String                  @map("api_version") @db.VarChar(16)
  views              Int?
  plays              Int?
  reach              Int?
  likes              Int?
  comments           Int?
  shares             Int?
  saves              Int?
  totalInteractions  Int?                    @map("total_interactions")
  // Total watch time exceeds a 32-bit range on a modestly popular Reel, so it is
  // the one count that needs a wider column.
  totalWatchTimeMs   BigInt?                 @map("total_watch_time_ms")
  averageWatchTimeMs Int?                    @map("average_watch_time_ms")
  skipRate           Decimal?                @map("skip_rate") @db.Decimal(6, 5)
  follows            Int?
  profileVisits      Int?                    @map("profile_visits")
  profileActivity    Int?                    @map("profile_activity")
  availability       Json
  followerCount      Int?                    @map("follower_count")
  rawPayload         Json                    @map("raw_payload")
  rawPayloadHash     String                  @map("raw_payload_hash") @db.Char(64)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  post               InstagramPost           @relation(fields: [workspaceId, instagramPostId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([instagramPostId, ageBucket, apiVersion, rawPayloadHash])
  @@index([workspaceId, instagramPostId, capturedAt(sort: Desc)])
  @@index([workspaceId, instagramPostId, postAgeSeconds])
  @@index([workspaceId, syncRunId])
  @@map("instagram_metric_snapshots")
}

// One auditable import run. The cursor is opaque provider state and is advanced
// only in the same transaction that commits a page's posts, so a resumed run
// can never skip records. A partial unique index in the migration enforces one
// RUNNING run per account and trigger; Prisma cannot express a filtered unique
// index, so it lives in SQL only.
model SyncRun {
  id                 String           @id @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  instagramAccountId String           @map("instagram_account_id") @db.Uuid
  trigger            SyncRunTrigger
  idempotencyKey     String           @map("idempotency_key") @db.VarChar(255)
  backgroundJobId    String?          @map("background_job_id") @db.Uuid
  state              SyncRunState     @default(RUNNING)
  stage              String           @default("starting") @db.VarChar(64)
  horizonStart       DateTime?        @map("horizon_start") @db.Timestamptz(3)
  cursor             String?          @db.VarChar(512)
  pagesCompleted     Int              @default(0) @map("pages_completed")
  itemsSeen          Int              @default(0) @map("items_seen")
  itemsImported      Int              @default(0) @map("items_imported")
  itemsUpdated       Int              @default(0) @map("items_updated")
  itemsSkipped       Int              @default(0) @map("items_skipped")
  itemsInvalid       Int              @default(0) @map("items_invalid")
  apiVersion         String           @map("api_version") @db.VarChar(16)
  usageSummary       Json?            @map("usage_summary")
  correlationId      String           @map("correlation_id") @db.Uuid
  startedAt          DateTime         @map("started_at") @db.Timestamptz(3)
  checkpointAt       DateTime?        @map("checkpoint_at") @db.Timestamptz(3)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(3)
  failureClass       String?          @map("failure_class") @db.VarChar(32)
  failureCode        String?          @map("failure_code") @db.VarChar(64)
  requestedByUserId  String?          @map("requested_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account            InstagramAccount @relation(fields: [workspaceId, instagramAccountId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, instagramAccountId, trigger, idempotencyKey])
  @@index([workspaceId, instagramAccountId, startedAt(sort: Desc)])
  @@index([workspaceId, state, startedAt])
  @@index([correlationId])
  @@map("sync_runs")
}

model SystemSetting {
  id               String           @id @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  key              String           @db.VarChar(120)
  valueType        SettingValueType @map("value_type")
  value            Json
  version          Int
  effectiveAt      DateTime         @map("effective_at") @db.Timestamptz(3)
  changedByUserId  String?          @map("changed_by_user_id") @db.Uuid
  changedByService String?          @map("changed_by_service") @db.VarChar(100)
  changeReason     String           @map("change_reason") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  changedByUser    InternalUser?    @relation("setting_changed_by_user", fields: [workspaceId, changedByUserId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, key, version])
  @@index([workspaceId, key, effectiveAt(sort: Desc)])
  @@map("system_settings")
}

// Lifecycle of one multipart upload the server authorised.
//
// An intent exists from the moment the server reserves an object key until the
// upload either becomes an asset or is discarded. Terminal states are kept
// rather than deleted so an abandoned upload can be reconciled against the
// provider and so a repeated completion is recognised instead of re-run.
enum VideoUploadIntentState {
  PENDING
  COMPLETED
  ABORTED
  EXPIRED

  @@map("video_upload_intent_state")
}

// Only PENDING_VALIDATION is reachable from the upload commands. The validation
// worker owns the transition to READY or REJECTED; nothing here may publish an
// asset that a probe has not accepted.
enum VideoAssetState {
  PENDING_VALIDATION
  READY
  REJECTED

  @@map("video_asset_state")
}

// Why validation refused an asset. These are the only rejection details that
// reach a user, a log line or an API response: the probe's own message can echo
// container internals and the temporary file path, so it is never surfaced.
enum VideoAssetRejectionCode {
  EMPTY_OBJECT
  BYTES_EXCEEDED
  CHECKSUM_MISMATCH
  CONTAINER_UNSUPPORTED
  CONTAINER_MISMATCH
  UNDECODABLE
  NO_VIDEO_STREAM
  VIDEO_CODEC_UNSUPPORTED
  AUDIO_CODEC_UNSUPPORTED
  DURATION_OUT_OF_RANGE
  DIMENSIONS_OUT_OF_RANGE

  @@map("video_asset_rejection_code")
}

// A server-authorised intent to upload one source video for one post.
//
// The client never supplies the object key, the bucket or the byte limit: the
// server reserves all three, and `declaredBytes`/`declaredContentType` record
// only what the browser claimed so a later mismatch against server-observed
// metadata is provable rather than silent.
//
// `pendingForPostId` mirrors `instagramPostId` while the intent is PENDING and
// is nulled on every terminal state. Postgres ignores nulls in unique indexes,
// so this gives the documented "at most one pending replacement intent" rule a
// real database guarantee while still allowing a post to accumulate any number
// of completed, aborted and expired intents. A partial index would express the
// same rule but would not be visible to schema.prisma, and db:drift:check
// compares the live database against this file.
model VideoUploadIntent {
  id                  String                 @id @db.Uuid
  workspaceId         String                 @map("workspace_id") @db.Uuid
  instagramPostId     String                 @map("instagram_post_id") @db.Uuid
  pendingForPostId    String?                @map("pending_for_post_id") @db.Uuid
  objectKey           String                 @map("object_key") @db.VarChar(512)
  bucket              String                 @db.VarChar(63)
  region              String                 @db.VarChar(64)
  providerUploadId    String                 @map("provider_upload_id") @db.VarChar(512)
  declaredBytes       BigInt                 @map("declared_bytes")
  declaredContentType String                 @map("declared_content_type") @db.VarChar(128)
  partSizeBytes       Int                    @map("part_size_bytes")
  partCount           Int                    @map("part_count")
  state               VideoUploadIntentState @default(PENDING)
  expiresAt           DateTime               @map("expires_at") @db.Timestamptz(3)
  completedAt         DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdByUserId     String                 @map("created_by_user_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  post                InstagramPost          @relation(fields: [workspaceId, instagramPostId], references: [workspaceId, id], onDelete: Restrict)
  createdByUser       InternalUser           @relation("upload_intent_created_by_user", fields: [workspaceId, createdByUserId], references: [workspaceId, id], onDelete: Restrict)
  asset               VideoAsset?

  @@unique([workspaceId, id])
  @@unique([objectKey])
  @@unique([workspaceId, pendingForPostId])
  @@index([workspaceId, instagramPostId, createdAt(sort: Desc)])
  @@index([state, expiresAt])
  @@map("video_upload_intents")
}

// One uploaded source video, recorded from server-observed object metadata.
//
// `etag` is the provider's integrity token, not a cryptographic digest: for a
// multipart object S3 returns a composite of per-part hashes. `declaredChecksum`
// is what the browser claimed and is advisory only. `verifiedChecksum` is filled
// by the validation worker when it streams the object, and until then the asset
// stays PENDING_VALIDATION and is not eligible for analysis.
//
// The intent relation is unique, so a retried or replayed completion resolves to
// the same asset row instead of creating a duplicate.
model VideoAsset {
  id               String                   @id @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  instagramPostId  String                   @map("instagram_post_id") @db.Uuid
  uploadIntentId   String                   @map("upload_intent_id") @db.Uuid
  objectKey        String                   @map("object_key") @db.VarChar(512)
  bucket           String                   @db.VarChar(63)
  region           String                   @db.VarChar(64)
  objectVersion    String?                  @map("object_version") @db.VarChar(256)
  etag             String                   @db.VarChar(256)
  bytes            BigInt
  contentType      String?                  @map("content_type") @db.VarChar(128)
  declaredChecksum String?                  @map("declared_checksum_sha256") @db.Char(64)
  verifiedChecksum String?                  @map("verified_checksum_sha256") @db.Char(64)
  state            VideoAssetState          @default(PENDING_VALIDATION)
  // Everything below is written once by the validation worker. Detected values
  // come from the probe, never from the browser, and stay null while the asset
  // is PENDING_VALIDATION or was rejected before the probe ran.
  durationMs       Int?                     @map("duration_ms")
  widthPx          Int?                     @map("width_px")
  heightPx         Int?                     @map("height_px")
  videoCodec       String?                  @map("video_codec") @db.VarChar(64)
  audioCodec       String?                  @map("audio_codec") @db.VarChar(64)
  containerFormat  String?                  @map("container_format") @db.VarChar(64)
  rejectionCode    VideoAssetRejectionCode? @map("rejection_code")
  validatedAt      DateTime?                @map("validated_at") @db.Timestamptz(3)
  // Set when an asset is rejected so the cleanup sweep can purge the stored
  // object on the retention schedule without re-deriving the policy.
  purgeAfter       DateTime?                @map("purge_after") @db.Timestamptz(3)
  purgedAt         DateTime?                @map("purged_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  post             InstagramPost            @relation(fields: [workspaceId, instagramPostId], references: [workspaceId, id], onDelete: Restrict)
  uploadIntent     VideoUploadIntent        @relation(fields: [workspaceId, uploadIntentId], references: [workspaceId, id], onDelete: Restrict)
  analysisJobs     AnalysisJob[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, uploadIntentId])
  @@unique([objectKey])
  @@index([workspaceId, instagramPostId, createdAt(sort: Desc)])
  @@index([workspaceId, state])
  // Drives the purge sweep over rejected objects still holding bytes.
  @@index([state, purgeAfter])
  @@map("video_assets")
}

enum AnalysisJobStage {
  QUEUED
  UPLOADING
  AWAITING_FILE
  REQUESTING
  VALIDATING
  REPAIRING
  PUBLISHED
  ABANDONED

  @@map("analysis_job_stage")
}

// The durable record of one logical request to analyse one post's input set.
//
// This exists alongside `BackgroundJob` rather than inside it because two facts
// have to survive a crash that the generic job row cannot carry. The fixed
// inputs are frozen here at request time, so a retry analyses exactly what was
// asked for even if the post has since gained a newer asset. And
// `providerFileName` is written the moment the provider accepts an upload, so a
// worker that dies mid-request can release or reuse that file instead of
// abandoning paid bytes to their 48-hour expiry.
//
// `requestSignature` is the idempotency anchor: it hashes the inputs and the
// contract versions, so asking twice for the same analysis of the same video
// under the same contract is one logical request and one provider call.
model AnalysisJob {
  id                   String           @id @db.Uuid
  workspaceId          String           @map("workspace_id") @db.Uuid
  backgroundJobId      String           @map("background_job_id") @db.Uuid
  instagramPostId      String           @map("instagram_post_id") @db.Uuid
  videoAssetId         String           @map("video_asset_id") @db.Uuid
  // Null until #39 delivers transcripts. Recorded either way so a later
  // analysis of the same video with a transcript is a different signature.
  transcriptRevisionId String?          @map("transcript_revision_id") @db.Uuid
  requestSignature     String           @map("request_signature") @db.Char(64)
  schemaVersion        String           @map("schema_version") @db.VarChar(64)
  promptVersion        String           @map("prompt_version") @db.VarChar(64)
  modelRequested       String           @map("model_requested") @db.VarChar(64)
  stage                AnalysisJobStage @default(QUEUED)
  // Provider file lifecycle. Cleared once the file is released, so a non-null
  // value always means bytes the provider is still holding for us.
  providerFileName     String?          @map("provider_file_name") @db.VarChar(128)
  providerFileExpiresAt DateTime?       @map("provider_file_expires_at") @db.Timestamptz(3)
  repairAttempted      Boolean          @default(false) @map("repair_attempted")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  backgroundJob        BackgroundJob    @relation(fields: [workspaceId, backgroundJobId], references: [workspaceId, id], onDelete: Restrict)
  post                 InstagramPost    @relation(fields: [workspaceId, instagramPostId], references: [workspaceId, id], onDelete: Restrict)
  asset                VideoAsset       @relation(fields: [workspaceId, videoAssetId], references: [workspaceId, id], onDelete: Restrict)
  analysis             PostAnalysis?

  @@unique([workspaceId, id])
  @@unique([workspaceId, backgroundJobId])
  @@index([workspaceId, instagramPostId, createdAt(sort: Desc)])
  @@index([workspaceId, requestSignature])
  // Finds jobs still holding a provider file, for cleanup after a crash.
  @@index([stage, providerFileExpiresAt])
  @@map("analysis_jobs")
}

// One immutable, validated creative analysis of one video.
//
// Rows are never updated. A re-analysis produces a new row and moves the post's
// current pointer; the old row stays so a stored strategy that cited it still
// resolves. `result` is the exact validated object the semantic validator
// accepted, and the feature columns beside it are extracted copies for querying
// — analytics groups by them and must not parse JSON per row.
//
// The contract versions and hashes are recorded per analysis rather than
// referenced from a table, because #42 made the schema, prompt and model
// immutable code values with SHA-256 integrity. Storing the version and hash
// pins exactly what produced this row without a table that could drift from the
// constants it mirrors.
model PostAnalysis {
  id                 String        @id @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  instagramPostId    String        @map("instagram_post_id") @db.Uuid
  analysisJobId      String        @map("analysis_job_id") @db.Uuid
  videoAssetId       String        @map("video_asset_id") @db.Uuid
  transcriptRevisionId String?     @map("transcript_revision_id") @db.Uuid
  requestSignature   String        @map("request_signature") @db.Char(64)
  schemaVersion      String        @map("schema_version") @db.VarChar(64)
  schemaSha256       String        @map("schema_sha256") @db.Char(64)
  promptVersion      String        @map("prompt_version") @db.VarChar(64)
  promptSha256       String        @map("prompt_sha256") @db.Char(64)
  modelRequested     String        @map("model_requested") @db.VarChar(64)
  // What the provider says it actually ran, which is not always what was asked.
  modelVersion       String?       @map("model_version") @db.VarChar(64)
  analysedAt         DateTime      @map("analysed_at") @db.Timestamptz(3)
  result             Json
  // Extracted for querying. Null means the model reported the field
  // unavailable, which analytics must treat as absent rather than as a value.
  contentPillar      String?       @map("content_pillar") @db.VarChar(64)
  contentFormat      String?       @map("content_format") @db.VarChar(64)
  hookCategory       String?       @map("hook_category") @db.VarChar(64)
  presenterMode      String?       @map("presenter_mode") @db.VarChar(64)
  ctaType            String?       @map("cta_type") @db.VarChar(64)
  durationSeconds    Decimal?      @map("duration_seconds") @db.Decimal(10, 3)
  overallConfidence  String        @map("overall_confidence") @db.VarChar(16)
  validationWarnings Json          @map("validation_warnings")
  inputTokens        Int?          @map("input_tokens")
  outputTokens      Int?           @map("output_tokens")
  totalTokens        Int?          @map("total_tokens")
  providerLatencyMs  Int?          @map("provider_latency_ms")
  finishReason       String?       @map("finish_reason") @db.VarChar(64)
  // False when the analysis is too weak to group by, so analytics can exclude
  // it and count the exclusion rather than silently dropping the post.
  analyticsEligible  Boolean       @default(true) @map("analytics_eligible")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  post               InstagramPost @relation("PostAnalyses", fields: [workspaceId, instagramPostId], references: [workspaceId, id], onDelete: Restrict)
  job                AnalysisJob   @relation(fields: [workspaceId, analysisJobId], references: [workspaceId, id], onDelete: Restrict)
  currentForPost     InstagramPost? @relation("CurrentPostAnalysis")

  @@unique([workspaceId, id])
  // One analysis per logical request. This is what makes a redelivered job
  // publish at most one row.
  @@unique([workspaceId, analysisJobId])
  @@unique([workspaceId, requestSignature])
  @@index([workspaceId, instagramPostId, analysedAt(sort: Desc)])
  @@index([workspaceId, analyticsEligible, contentPillar])
  @@index([workspaceId, analyticsEligible, hookCategory])
  @@map("post_analyses")
}

enum FeatureStatisticConfidence {
  INSUFFICIENT_EVIDENCE
  SINGLE_POST_OUTLIER
  WEAK_DIRECTIONAL_SIGNAL
  MODERATE_ASSOCIATION
  STATISTICALLY_SUPPORTED_ASSOCIATION

  @@map("feature_statistic_confidence")
}

// One immutable statement about one feature value against one metric.
//
// Rows are never updated. A recalculation writes a new row with a new input
// fingerprint and leaves the old one, because a stored strategy that cited a
// statistic must still resolve exactly what it cited — rewriting the number
// under it would silently change what a published claim meant.
//
// `inputFingerprint` covers the posts, snapshots and analyses that produced the
// result, so #52 can tell whether a recalculation could change anything before
// spending a run. It is what makes "nothing has changed" cheap to answer.
//
// Every field a reader needs to judge the claim is stored beside it: both
// sample sizes, both medians and spreads, the effect, the uncertainty, the
// sensitivity outcome and the reason for the classification. A trend that
// cannot show its own working is not evidence.
model AccountFeatureStatistic {
  id                     String                     @id @db.Uuid
  workspaceId            String                     @map("workspace_id") @db.Uuid
  instagramAccountId     String                     @map("instagram_account_id") @db.Uuid
  // Dotted path into the analysis contract, such as `content.hook.category`.
  featurePath            String                     @map("feature_path") @db.VarChar(128)
  featureValue           String                     @map("feature_value") @db.VarChar(64)
  metric                 String                     @db.VarChar(64)
  ageWindow              String                     @map("age_window") @db.VarChar(16)
  publishedFrom          DateTime                   @map("published_from") @db.Timestamptz(3)
  publishedTo            DateTime                   @map("published_to") @db.Timestamptz(3)
  groupCount             Int                        @map("group_count")
  comparisonCount        Int                        @map("comparison_count")
  groupMedian            Decimal?                   @map("group_median") @db.Decimal(20, 8)
  groupIqr               Decimal?                   @map("group_iqr") @db.Decimal(20, 8)
  comparisonMedian       Decimal?                   @map("comparison_median") @db.Decimal(20, 8)
  comparisonIqr          Decimal?                   @map("comparison_iqr") @db.Decimal(20, 8)
  differenceOfMedians    Decimal?                   @map("difference_of_medians") @db.Decimal(20, 8)
  relativeEffect         Decimal?                   @map("relative_effect") @db.Decimal(20, 8)
  intervalLower          Decimal?                   @map("interval_lower") @db.Decimal(20, 8)
  intervalUpper          Decimal?                   @map("interval_upper") @db.Decimal(20, 8)
  intervalConfidence     Decimal?                   @map("interval_confidence") @db.Decimal(4, 3)
  bootstrapSeed          BigInt?                    @map("bootstrap_seed")
  bootstrapResamples     Int?                       @map("bootstrap_resamples")
  confidence             FeatureStatisticConfidence
  classificationReason   String                     @map("classification_reason") @db.VarChar(64)
  topContributorShare    Decimal?                   @map("top_contributor_share") @db.Decimal(6, 5)
  sensitivityHoldsDirection Boolean?                @map("sensitivity_holds_direction")
  missingRatio           Decimal                    @map("missing_ratio") @db.Decimal(6, 5)
  distinctPublicationDates Int                      @map("distinct_publication_dates")
  distinctPublicationWeeks Int                      @map("distinct_publication_weeks")
  multipleTestingApplied  Boolean                   @default(false) @map("multiple_testing_applied")
  // Every version that could change this number, so a stale row is detectable.
  analyticsVersion       String                     @map("analytics_version") @db.VarChar(64)
  statisticsVersion      String                     @map("statistics_version") @db.VarChar(64)
  cohortVersion          String                     @map("cohort_version") @db.VarChar(64)
  analysisSchemaVersion  String                     @map("analysis_schema_version") @db.VarChar(64)
  inputFingerprint       String                     @map("input_fingerprint") @db.Char(64)
  calculatedAt           DateTime                   @map("calculated_at") @db.Timestamptz(3)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace              Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account                InstagramAccount           @relation(fields: [workspaceId, instagramAccountId], references: [workspaceId, id], onDelete: Restrict)
  members                AccountFeatureStatisticPost[]

  @@unique([workspaceId, id])
  // One row per identical question and identical inputs. A repeat calculation
  // over unchanged data collapses instead of accumulating duplicates.
  @@unique([workspaceId, instagramAccountId, featurePath, featureValue, metric, ageWindow, inputFingerprint], map: "account_feature_statistics_question_inputs_key")
  // Explicit names: the generated ones truncate to the same string.
  @@index([workspaceId, instagramAccountId, calculatedAt(sort: Desc)], map: "account_feature_statistics_account_calculated_at_idx")
  @@index([workspaceId, instagramAccountId, confidence], map: "account_feature_statistics_account_confidence_idx")
  @@index([workspaceId, instagramAccountId, featurePath, metric], map: "account_feature_statistics_account_feature_metric_idx")
  @@map("account_feature_statistics")
}

// Which posts contributed to a statistic, and on which side.
//
// Stored rather than recomputed because the contract requires every claim to
// link to the exact posts behind it, and because a later recalculation must not
// change what an already-published claim was based on.
model AccountFeatureStatisticPost {
  id                 String                  @id @db.Uuid
  workspaceId        String                  @map("workspace_id") @db.Uuid
  statisticId        String                  @map("statistic_id") @db.Uuid
  instagramPostId    String                  @map("instagram_post_id") @db.Uuid
  metricSnapshotId   String                  @map("metric_snapshot_id") @db.Uuid
  postAnalysisId     String                  @map("post_analysis_id") @db.Uuid
  // Which side of the comparison this post sat on.
  membership         String                  @db.VarChar(16)
  value              Decimal                 @db.Decimal(20, 8)
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  statistic          AccountFeatureStatistic @relation(fields: [workspaceId, statisticId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([statisticId, instagramPostId])
  @@index([workspaceId, instagramPostId])
  @@map("account_feature_statistic_posts")
}
