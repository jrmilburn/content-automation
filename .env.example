# Safe local defaults. Never place provider credentials in this file.
APP_ENV=local
APP_RELEASE=development
AUTH_GOOGLE_ID=local-google-client.invalid
AUTH_GOOGLE_SECRET=local-google-secret-not-live
AUTH_SECRET=local-only-auth-secret-not-for-deployment-000000
AUTH_SESSION_MAX_AGE_SECONDS=28800
DATABASE_URL=postgresql://studio_parallel:studio_parallel@127.0.0.1:5432/studio_parallel
# Prisma migrations only. A managed provider issues two URLs: a transaction
# pooler for the application, which holds no session state, and a session pooler
# or direct connection. Prisma's schema engine needs session-level features, so a
# migration through the transaction pooler fails with a bare "Schema engine
# error". Locally the two are the same database.
DIRECT_URL=postgresql://studio_parallel:studio_parallel@127.0.0.1:5432/studio_parallel
GOOGLE_WORKSPACE_DOMAIN=example.invalid
PROVIDER_MODE=fake
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
QUEUE_DISPATCH_BATCH_SIZE=20
QUEUE_RECONCILE_INTERVAL_SECONDS=5
WORKER_HEALTH_PORT=3001
WORKER_SHUTDOWN_GRACE_SECONDS=30
LOG_LEVEL=info

# Private S3-compatible source-video storage. Bucket, region and endpoint are
# safe deploy config. The local default bucket name is rejected in staging and
# production so a deployment cannot silently write to a placeholder.
STORAGE_BUCKET=local-source-video-not-live
STORAGE_REGION=auto
# Cloudflare R2 and MinIO supply an endpoint; AWS S3 leaves it unset. MinIO also
# needs path-style addressing.
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=1073741824
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_SIGNED_URL_TTL_SECONDS=900
UPLOAD_ABANDON_AFTER_HOURS=24

# Source-video validation policy, read only by the worker: the web image never
# decodes media. The accepted formats are deliberately narrower than what Gemini
# takes, so a format only widens once a fixture proves the deployed ffprobe
# handles it. Codec lists are lowercase and comma-separated.
MEDIA_MAX_DURATION_SECONDS=1200
MEDIA_MIN_DURATION_SECONDS=1
MEDIA_MIN_DIMENSION_PX=128
MEDIA_MAX_DIMENSION_PX=8192
MEDIA_ALLOWED_VIDEO_CODECS=h264,hevc,vp9,av1
MEDIA_ALLOWED_AUDIO_CODECS=aac,opus
# The probe parses attacker-influenced bytes, so it runs under an explicit
# wall-clock and output ceiling rather than inheriting the process default.
MEDIA_PROBE_TIMEOUT_MS=30000
MEDIA_PROBE_MAX_OUTPUT_BYTES=1048576

# Storage keys are never defaulted, so a misconfigured deployment fails closed
# instead of signing requests against an unintended account. Set only in the
# deployment secret manager.
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Set only in the deployment secret manager when Meta webhook verification is enabled.
# META_WEBHOOK_VERIFY_TOKEN=

# Instagram Business Login. These are the INSTAGRAM app credentials from
# Instagram > API setup with Instagram login > Business login settings, not the
# Facebook app values from App settings > Basic; the Facebook app id is rejected
# at the token endpoint as "Invalid platform app". Set only in the deployment
# secret manager.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Envelope encryption master key for stored integration credentials. Must decode
# to exactly 32 bytes: generate with `openssl rand -base64 32`. Database
# administrators and backups must not hold this value, so it is supplied only
# through the deployment secret manager. Raise the key version when rotating and
# re-encrypt existing rows.
# CREDENTIAL_ENCRYPTION_KEY=
# CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Gemini analysis. The model is an exact stable id and never a moving alias: a
# `latest` model would silently change the analysis behind a stored result, so
# it is rejected. Concurrency is a spend control rather than a politeness limit,
# because Gemini bills per token. The poll settings bound how long the worker
# waits for the Files API to finish processing an uploaded video.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_HOST=https://generativelanguage.googleapis.com
GEMINI_MAX_OUTPUT_TOKENS=32000
GEMINI_UPLOAD_TIMEOUT_MS=600000
GEMINI_REQUEST_TIMEOUT_MS=300000
GEMINI_FILE_POLL_INTERVAL_MS=2000
GEMINI_FILE_POLL_MAX_ATTEMPTS=60
GEMINI_PROJECT_CONCURRENCY=1

# The assistant answers in the request that asked, so it waits on a person
# rather than on a queue: the timeout is far lower than the analysis one because
# a reader gives up long before five minutes.
#
# The token ceiling is not the reply length. The model reasons before it writes
# and both are billed against this ceiling, so a limit sized for the answer
# alone truncates every turn before it produces one. The reply itself is capped
# by the response contract at 4000 characters; this leaves room to think.
GEMINI_CHAT_TIMEOUT_MS=45000
GEMINI_CHAT_MAX_OUTPUT_TOKENS=32000

# Paid Gemini project key. Needed by the worker for analysis and strategy, and
# by the web application for the assistant — which is the only model call the
# web process makes. Never defaulted, so a misconfigured deployment fails closed
# instead of billing an unintended project. Set only in the deployment secret
# manager, in both environments.
# GEMINI_API_KEY=
