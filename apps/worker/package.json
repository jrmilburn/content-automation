{
  "name": "@studio-parallel/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.worker src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@studio-parallel/config": "*",
    "@studio-parallel/db": "*",
    "@studio-parallel/domain": "*",
    "@studio-parallel/integrations": "*",
    "@studio-parallel/observability": "*",
    "@studio-parallel/queue": "*"
  }
}
